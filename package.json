{
  "name": "my-note-app-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian-like note-taking desktop app — Electrobun v1 + React + CodeMirror hybrid markdown editor",
  "scripts": {
    "build:renderer": "vite build",
    "start": "bun run build:renderer && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:canary": "bun run build:renderer && electrobun build --env=canary",
    "build:stable": "bun run build:renderer && electrobun build --env=stable",
    "type-check": "bash scripts/typecheck.sh",
    "test": "bun test"
  },
  "dependencies": {
    "electrobun": "1.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
